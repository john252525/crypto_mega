# ─── Database (PostgreSQL — auto-injected by Railway) ───
DATABASE_URL=postgresql://user:pass@localhost:5432/crypto_mega

# ─── Redis (auto-injected by Railway) ───
REDIS_URL=redis://localhost:6379/0

# ─── Exchange (KEEP SANDBOX=true until you're ready for real money!) ───
EXCHANGE_ID=binance
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here
EXCHANGE_SANDBOX=true

# ─── System ───
MAX_WORKERS=4
MAX_STRATEGIES=10
LOG_LEVEL=INFO
PORT=8000

# ─── Risk Management ───
MAX_RISK_PCT=2.0
MAX_DRAWDOWN_PCT=10.0
MAX_POSITION_PCT=5.0
MAX_POSITIONS=20
MAX_DAILY_TRADES=100
KILL_SWITCH_PCT=15.0
